# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Local-only test material (third-party prompts, not for the public repo)
tests/fixtures/local/

# CMake build output
build/

# LLM settings (holds the API key) and run transcripts
tools/llm.local.json
*.llm-runs/
__pycache__/

# Your prompts' indexes and topic lists: they quote your prompts and record
# local paths. Dummy ones meant for the repo end in .example and are kept,
# e.g. agent.index.json.example, agent.topics.txt.example.
*.index.json
*.index.json.bak
*.topics.txt
!*.example
